[Unit]
Description=SolarCare AI - Procesamiento de eventos con IA
Wants=ollama.service
After=ollama.service

[Service]
Type=oneshot
WorkingDirectory=/opt/solarcare

# Procesar los eventos pendientes mediante los modelos de IA.
ExecStart=/usr/bin/python3 -u /opt/solarcare/trabajador_ia.py

# Conservar los resultados generados por el trabajador.
StateDirectory=solarcare
StandardOutput=journal
StandardError=journal
